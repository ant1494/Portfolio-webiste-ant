<footer class="site-footer">
  <ul class="site-footer__social">
    {% for link in settings.social_links %}
      <li>
        <a href="{{ link.url }}" target="_blank" rel="noopener" aria-label="{{ link.label }}" class="social-icon">
          {% if link.icon == "instagram" %}
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor"/></svg>
          {% elif link.icon == "discord" %}
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 8.5C8 7 10 6.5 12 6.5s4 .5 6 2c1.2 3 1.4 6 1 9-1.6 1.2-3.2 1.8-3.2 1.8l-.7-1.3c1-.3 1.9-.8 1.9-.8-2 1-4 1.4-5 1.4s-3-.4-5-1.4c0 0 .9.5 1.9.8l-.7 1.3S6.6 18.7 5 17.5c-.4-3-.2-6 1-9Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="9.5" cy="13" r="1.15" fill="currentColor"/><circle cx="14.5" cy="13" r="1.15" fill="currentColor"/></svg>
          {% elif link.icon == "linkedin" %}
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="2" width="20" height="20" rx="3" stroke="currentColor" stroke-width="1.6"/><rect x="6.3" y="10" width="2.2" height="8" fill="currentColor"/><circle cx="7.4" cy="6.8" r="1.3" fill="currentColor"/><path d="M11.3 18v-8h2.2v1.2c.5-.8 1.4-1.4 2.6-1.4 2 0 3 1.3 3 3.6V18h-2.2v-4.2c0-1.1-.4-1.8-1.5-1.8-.8 0-1.3.5-1.5 1-.1.2-.1.5-.1.9V18h-2.5Z" fill="currentColor"/></svg>
          {% endif %}
        </a>
      </li>
    {% endfor %}
  </ul>
</footer>

<!-- Lightbox overlay shared by gallery pages -->
<div class="lightbox" id="lightbox" hidden>
  <button class="lightbox__close" id="lightbox-close" aria-label="Close">&times;</button>
  <button class="lightbox__prev" id="lightbox-prev" aria-label="Previous image">&larr;</button>
  <img class="lightbox__image" id="lightbox-image" src="" alt="">
  <p class="lightbox__caption" id="lightbox-caption"></p>
  <button class="lightbox__next" id="lightbox-next" aria-label="Next image">&rarr;</button>
</div>
