<header class="site-header">
  <div class="site-header__inner">
    <a class="site-logo" href="{{ '/' | url }}" aria-label="{{ settings.artist_name }} — home">
      <!-- 
        Empty span. The CSS mask-image will pull your PNG from /static/images/
        and color it using currentColor (light/dark mode ready).
      -->
      <span class="site-logo__mark"></span>
    </a>

    <button class="site-header__toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav">
      {% for item in nav %}
        <a
          href="{{ item.href | url }}"
          class="site-nav__link{% if page.url == item.href %} is-active{% endif %}"
        >
          {{ item.label }}
        </a>
      {% endfor %}
    </nav>
  </div>
</header>
