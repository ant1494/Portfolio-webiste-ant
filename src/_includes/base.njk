<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  
<!--SEO things-->
  <title>{% if title %}{{ title }} — {{ settings.artist_name }}{% else %}{{ settings.site_title }}{% endif %}</title>
<meta name="description" content="{{ description or settings.site_description }}">
<meta name="robots" content="{{ robots or 'index, follow' }}">

<link rel="canonical" href="{{ settings.site_url }}{{ page.url | url }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{% if title %}{{ title }} — {{ settings.artist_name }}{% else %}{{ settings.site_title }}{% endif %}">
  <meta property="og:description" content="{{ description or settings.site_description }}">
  <meta property="og:url" content="{{ settings.site_url }}{{ page.url | url }}">
  <meta property="og:image" content="{{ settings.site_url }}{{ settings.og_image | url }}">
  <meta name="twitter:card" content="summary_large_image">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <!--
    Kalmansk is a purchased/self-hosted font, not on a public CDN.
    Drop your font files at static/fonts/kalmansk.woff2 (and .woff as a
    fallback) and this will pick them up automatically. Until then the
    site falls back to the system serif defined in --font-nav below.
  -->
	<style>
	  @font-face {
		font-family: "Kalmansk";
		src: url("/static/fonts/kalmansk-regular.otf") format("opentype");
		font-display: swap;
			}
	</style>

  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <link rel="icon" href="{{ '/static/images/favicon.ico' | url }}">

  <script>
    if (window.location.hash && /invite_token|recovery_token|confirmation_token|email_change_token/.test(window.location.hash)) {
      window.location.href = "{{ '/admin/' | url }}" + window.location.hash;
    }
  </script>
</head>
<body>
  <div id="top"></div>
  {% include "partials/nav.njk" %}
  <main>
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="{{ '/js/main.js' | url }}" defer></script>
</body>
</html>
