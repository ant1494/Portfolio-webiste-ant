<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ settings.site_title }}</title>
  <meta name="description" content="{{ settings.tagline }}">

  <!--
    Kalmansk is a purchased/self-hosted font, not on a public CDN.
    Drop your font files at static/fonts/kalmansk.woff2 (and .woff as a
    fallback) and this will pick them up automatically. Until then the
    site falls back to the system serif defined in --font-nav below.
  -->
  <style>
    @font-face {
      font-family: "Kalmansk";
      src: url("/static/fonts/kalmansk.woff2") format("woff2"),
           url("/static/fonts/kalmansk.woff") format("woff");
      font-display: swap;
    }
  </style>

  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><text y=%2224%22 font-size=%2224%22>🐜</text></svg>">

  <script>
    if (window.location.hash && /invite_token|recovery_token|confirmation_token|email_change_token/.test(window.location.hash)) {
      window.location.href = "{{ '/admin/' | url }}" + window.location.hash;
    }
  </script>
</head>
<body>
  <div id="top"></div>
  {% include "partials/nav.njk" %}
  <main>
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="{{ '/js/main.js' | url }}" defer></script>
</body>
</html>
