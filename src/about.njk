---
layout: base.njk
permalink: /about/
---
<div class="about-split">
  <div class="about-split__portrait">
    <!--
      Placeholder line drawing. Swap the <path> for your real portrait's
      outline paths (keep fill="currentColor" / stroke="currentColor") and
      it will flip color with dark mode automatically, same trick as the
      header logo.
    -->
    <svg viewBox="0 0 300 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Portrait">
      <rect x="1" y="1" width="298" height="358" fill="none" stroke="currentColor" stroke-width="2"/>
      <circle cx="150" cy="140" r="60" fill="none" stroke="currentColor" stroke-width="2"/>
      <path d="M60 340 Q150 220 240 340" fill="none" stroke="currentColor" stroke-width="2"/>
    </svg>
  </div>

  <div class="about-split__text">
    <h2 class="section-title">{{ settings.about_heading }}</h2>
    <p>{{ settings.about_text }}</p>
    {% if settings.resume_url %}
      <p><a class="email-link" href="{{ settings.resume_url }}" target="_blank" rel="noopener">Download résumé</a></p>
    {% endif %}
    {% if settings.contact_email %}
      <p><a class="email-link" href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></p>
    {% endif %}
  </div>
</div>
