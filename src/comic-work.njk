---
layout: base.njk
permalink: /comic-work/
---

<p class="comic-credit">
  {{ settings.comic_credit_text }}
  {% for link in settings.comic_credit_links %}
    <a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a>{% if not loop.last %}, {% endif %}
  {% endfor %}
</p>

<div class="two-col-grid">
  {% for piece in comicWork %}
    <button class="two-col-grid__item" data-lightbox-index="{{ loop.index0 }}" data-lightbox-group="comic-work" aria-label="View {{ piece.title }}">
      <img src="{{ piece.image | url }}" alt="{{ piece.title }}" loading="lazy">
    </button>
  {% endfor %}
</div>

<div class="back-bar">
  <a href="#top" class="back-button">Back</a>
</div>

<script type="application/json" class="gallery-data" data-group="comic-work">
  {{ comicWork | withPrefixedImages | dump | safe }}
</script>
